---
interface Props { pathname?: string; }
const { pathname = "/" } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="DeshFiles home">
      <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><defs><linearGradient id="brand-blue" x1="5" y1="4" x2="34" y2="37" gradientUnits="userSpaceOnUse"><stop stop-color="#69C7FF"/><stop offset="1" stop-color="#1674E9"/></linearGradient></defs><path d="M8 4.5h15l9 9v21H8z" fill="url(#brand-blue)"/><path d="M23 4.5v9h9" fill="#BDEBFF" fill-opacity=".72"/><path d="M14 20h11M14 25h11M14 30h7" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><path d="M8 34.5h24" stroke="#125DC5" stroke-opacity=".38" stroke-width="1.5"/></svg></span>
      <span>DeshFiles</span>
    </a>
    <nav class="header-nav" aria-label="Main navigation">
      <a class:list:active={pathname === "/"} href="/" aria-current={pathname === "/" ? "page" : undefined}>Home</a>
      <a href="/#tools">All Tools</a>
      <a class:list:active={pathname.startsWith("/about")} href="/about/" aria-current={pathname.startsWith("/about") ? "page" : undefined}>About</a>
    </nav>
    <div class="header-tools"><span class="india-badge" aria-label="Built in India">🇮🇳 <span>Built in India</span></span></div>
  </div>
</header>

<style>
  .site-header { width:100%; border-bottom:1px solid rgba(223,231,241,.8); background:rgba(255,255,255,.88); backdrop-filter:blur(14px); position:sticky; top:0; z-index:10; }
  .header-inner { width:min(100% - 40px,var(--container-width)); min-height:70px; margin:0 auto; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; }
  .logo { display:inline-flex; align-items:center; justify-self:start; gap:9px; color:#101b37; font-size:20px; font-weight:750; letter-spacing:-.045em; }.brand-mark { display:grid; place-items:center; width:38px; height:38px; border-radius:11px; background:#eaf5ff; box-shadow:0 7px 16px #287eea2b; }.brand-mark svg { width:34px; height:34px; }
  .header-nav { display:flex; align-items:center; justify-content:center; gap:8px; }.header-nav a { padding:10px 16px; border-radius:12px; color:#101b37; font-size:14px; font-weight:500; transition:color var(--transition),background var(--transition); }.header-nav a:hover { color:var(--color-primary); background:#f2f7ff; }.header-nav a.active { color:#145dcc; background:#edf4ff; font-weight:650; }
  .header-tools { display:flex; justify-content:flex-end; }.india-badge { display:inline-flex; align-items:center; gap:7px; padding:9px 14px; border:1px solid #f0e5df; border-radius:12px; background:#fff8f5; color:#1b2942; box-shadow:0 3px 10px #855d3710; font-size:13px; font-weight:650; white-space:nowrap; }
  @media (max-width:600px) { .header-inner{width:min(100% - 24px,var(--container-width));min-height:62px}.logo{font-size:18px}.brand-mark{width:32px;height:32px;border-radius:9px}.brand-mark svg{width:29px;height:29px}.header-nav{gap:0}.header-nav a{padding:8px 7px;font-size:12px}.india-badge{padding:7px 8px;border-radius:10px}.india-badge span{display:none} }
  @media (max-width:430px) { .logo>span:last-child{display:none}.header-nav a{padding-inline:5px;font-size:11px}.india-badge{font-size:16px} }
</style>
