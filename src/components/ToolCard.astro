---
import type { Tool } from "../lib/tools";
import ToolIcon from "./ToolIcon.astro";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

{tool.available ? (
  <a
    class="tool-card available"
    href={`/pdf-tools/tools/${tool.slug}/`}
    aria-label={`Open ${tool.name}`}
  >
    <ToolIcon type={tool.slug} />

    <div class="tool-content">
      <h3>{tool.name}</h3>
      <p>{tool.description}</p>
    </div>

    <div class="tool-action" aria-hidden="true">→</div>
  </a>
) : (
  <article class="tool-card coming-soon-card">
    <ToolIcon type={tool.slug} />

    <div class="tool-content">
      <div class="tool-heading">
        <h3>{tool.name}</h3>
        
      </div>

      <p>{tool.description}</p>
    </div>
  </article>
)}

<style>
  .tool-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-height: 96px;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .tool-card.available {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .tool-card.available:hover {
  transform: translateY(-2px);
  border-color: #d0d3d7;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.10);
}

/* ADD THIS */
.tool-card.coming-soon-card {
  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.tool-card.coming-soon-card:hover {
  transform: translateY(-2px);
  border-color: #d0d3d7;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.10);
}

  .tool-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .tool-icon span {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: -0.2px;
  }

  .tool-content {
    min-width: 0;
    padding-right: 24px;
  }

  .tool-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 700;
  }

  p {
    margin: 5px 0 0;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .coming-soon {
    padding: 3px 7px;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 600;
  }

  .tool-action {
    position: absolute;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    color: var(--color-muted);
    font-size: 18px;
  }

  @media (max-width: 600px) {
    .tool-card {
      min-height: 92px;
      padding: 16px;
    }
  }
</style>