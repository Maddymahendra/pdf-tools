---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ToolPage from "../../../components/ToolPage.astro";
---

<BaseLayout
  title="JPG to PDF — Free Online Converter"
  description="Convert JPG and PNG images into a PDF. Arrange images, choose page settings, and create your PDF directly in your browser."
>
  <ToolPage
    title="JPG to PDF"
    description="Turn your JPG and PNG images into a clean PDF in seconds. Arrange your images, choose your page settings, and download."
  >
    <div class="workspace">

      <label class="upload" id="uploadArea">
        <div class="upload-icon">↑</div>

        <h2>Drop your images here</h2>

        <p>
          JPG, JPEG or PNG • Multiple images supported
        </p>

        <span class="upload-button">
          Choose images
        </span>

        <input
          type="file"
          id="fileInput"
          accept="image/jpeg,image/png"
          multiple
        >
      </label>

      <div class="settings">

        <div class="setting">
          <label for="pageSize">Page size</label>

          <select id="pageSize">
            <option value="a4">A4</option>
            <option value="letter">Letter</option>
            <option value="image">Image size</option>
          </select>
        </div>

        <div class="setting">
          <label for="orientation">Orientation</label>

          <select id="orientation">
            <option value="portrait">Portrait</option>
            <option value="landscape">Landscape</option>
            <option value="auto">Auto</option>
          </select>
        </div>

        <div class="setting">
          <label for="margin">Margin</label>

          <select id="margin">
            <option value="10">10 mm</option>
            <option value="5">5 mm</option>
            <option value="0">No margin</option>
          </select>
        </div>

        <div class="setting">
          <label for="layout">Layout</label>

          <select id="layout">
            <option value="single">One image per page</option>
            <option value="multiple">Multiple images per page</option>
          </select>
        </div>

      </div>

      <section class="images-section" id="imagesSection">

        <div class="images-header">
          <h3>Selected images</h3>
          <span id="imageCount">0 images</span>
        </div>

        <div class="image-grid" id="imageGrid"></div>

      </section>

      <div class="status" id="status"></div>

      <div class="actions">

        <button
          class="secondary-button"
          id="clearButton"
          type="button"
        >
          Clear all
        </button>

        <button
          class="primary-button"
          id="createButton"
          type="button"
          disabled
        >
          Create PDF
        </button>

      </div>

    </div>
  </ToolPage>
</BaseLayout>

<script
  src="https://cdn.jsdelivr.net/npm/jspdf@4.2.1/dist/jspdf.umd.min.js"
  is:inline
></script>

<script is:inline>
  const { jsPDF } = window.jspdf;

  const fileInput = document.getElementById("fileInput");
  const uploadArea = document.getElementById("uploadArea");
  const imageGrid = document.getElementById("imageGrid");
  const imagesSection = document.getElementById("imagesSection");
  const imageCount = document.getElementById("imageCount");
  const createButton = document.getElementById("createButton");
  const clearButton = document.getElementById("clearButton");
  const status = document.getElementById("status");

  let images = [];

  fileInput.addEventListener("change", function () {
    addFiles(this.files);
    this.value = "";
  });

  uploadArea.addEventListener("dragover", function (event) {
    event.preventDefault();
    uploadArea.classList.add("dragging");
  });

  uploadArea.addEventListener("dragleave", function () {
    uploadArea.classList.remove("dragging");
  });

  uploadArea.addEventListener("drop", function (event) {
    event.preventDefault();
    uploadArea.classList.remove("dragging");

    addFiles(event.dataTransfer.files);
  });

  function addFiles(files) {
    const validFiles = Array.from(files).filter(file =>
      file.type === "image/jpeg" ||
      file.type === "image/png"
    );

    validFiles.forEach(file => {
      const reader = new FileReader();

      reader.onload = function (event) {
        images.push({
          file: file,
          src: event.target.result,
          name: file.name
        });

        renderImages();
      };

      reader.readAsDataURL(file);
    });
  }

  function renderImages() {
    imageGrid.innerHTML = "";

    imagesSection.style.display =
      images.length ? "block" : "none";

    createButton.disabled =
      images.length === 0;

    imageCount.textContent =
      `${images.length} ${images.length === 1 ? "image" : "images"}`;

    images.forEach((image, index) => {
      const card = document.createElement("div");
      card.className = "image-card";

      card.innerHTML = `
        <img
          class="preview"
          src="${image.src}"
          alt=""
        >

        <button
          class="remove-image"
          type="button"
          title="Remove image"
        >
          ×
        </button>

        <div class="image-info">
          <div class="image-name">
            ${escapeHtml(image.name)}
          </div>

          <div class="image-number">
            Image ${index + 1}
          </div>
        </div>
      `;

      card
        .querySelector(".remove-image")
        .addEventListener("click", function () {
          images.splice(index, 1);
          renderImages();
        });

      imageGrid.appendChild(card);
    });
  }

  function escapeHtml(text) {
    const div = document.createElement("div");
    div.textContent = text;

    return div.innerHTML;
  }

  clearButton.addEventListener("click", function () {
    images = [];

    renderImages();

    status.style.display = "none";
    status.textContent = "";
  });

  createButton.addEventListener("click", createPDF);

  async function createPDF() {
    if (!images.length) return;

    createButton.disabled = true;
    clearButton.disabled = true;

    status.style.display = "block";
    status.textContent = "Creating your PDF...";

    try {
      const pageSize =
        document.getElementById("pageSize").value;

      const orientation =
        document.getElementById("orientation").value;

      const margin =
        Number(document.getElementById("margin").value);

      const layout =
        document.getElementById("layout").value;

      /*
       * Image-size mode always keeps one image per page.
       * This avoids mixing pixel-sized pages with the
       * multi-image A4/Letter layout.
       */
      if (pageSize === "image") {
        await createImageSizePDF();
      } else if (layout === "multiple") {
        await createMultipleImagesPDF(
          pageSize,
          orientation,
          margin
        );
      } else {
        await createSingleImagePDF(
          pageSize,
          orientation,
          margin
        );
      }

      status.textContent =
        "PDF created successfully.";

    } catch (error) {

      console.error(error);

      status.textContent =
        "Something went wrong while creating the PDF. Please try again.";

    } finally {
      createButton.disabled = false;
      clearButton.disabled = false;
    }
  }

  async function createSingleImagePDF(
    pageSize,
    orientation,
    margin
  ) {
    let pdf;

    let selectedOrientation = orientation;

    if (selectedOrientation === "auto") {
      const firstImage =
        await loadImage(images[0].src);

      selectedOrientation =
        firstImage.naturalWidth >
        firstImage.naturalHeight
          ? "landscape"
          : "portrait";
    }

    pdf = new jsPDF({
      orientation: selectedOrientation,
      unit: "mm",
      format: pageSize
    });

    for (let i = 0; i < images.length; i++) {

      status.textContent =
        `Creating PDF... ${i + 1} of ${images.length}`;

      const image =
        await loadImage(images[i].src);

      if (i > 0) {
        pdf.addPage(
          pageSize,
          orientation === "auto"
            ? (
                image.naturalWidth >
                image.naturalHeight
                  ? "landscape"
                  : "portrait"
              )
            : orientation
        );
      }

      addImageToPDF(
        pdf,
        image,
        margin
      );
    }

    pdf.save("images-to-pdf.pdf");
  }

  async function createMultipleImagesPDF(
    pageSize,
    orientation,
    margin
  ) {
    let selectedOrientation = orientation;

    if (selectedOrientation === "auto") {
      const firstImage =
        await loadImage(images[0].src);

      selectedOrientation =
        firstImage.naturalWidth >
        firstImage.naturalHeight
          ? "landscape"
          : "portrait";
    }

    const pdf = new jsPDF({
      orientation: selectedOrientation,
      unit: "mm",
      format: pageSize
    });

    const pageWidth =
      pdf.internal.pageSize.getWidth();

    const pageHeight =
      pdf.internal.pageSize.getHeight();

    const availableWidth =
      pageWidth - margin * 2;

    const availableHeight =
      pageHeight - margin * 2;

    /*
     * We use a simple responsive grid:
     *
     * 1–2 images: 2 columns
     * 3–4 images: 2 columns
     * 5+ images: 3 columns
     *
     * Images are automatically scaled to fit their
     * cells while preserving their aspect ratio.
     */

    const columns =
      images.length <= 4 ? 2 : 3;

    const gap = 8;

    const rowsPerPage =
      images.length <= 2 ? 1 : 2;

    const cellWidth =
      (
        availableWidth -
        gap * (columns - 1)
      ) / columns;

    const cellHeight =
      (
        availableHeight -
        gap * (rowsPerPage - 1)
      ) / rowsPerPage;

    let pageIndex = 0;

    for (let i = 0; i < images.length; i++) {

      if (i > 0 && i % (columns * rowsPerPage) === 0) {
        pdf.addPage(
          pageSize,
          selectedOrientation
        );

        pageIndex++;
      }

      status.textContent =
        `Creating PDF... ${i + 1} of ${images.length}`;

      const image =
        await loadImage(images[i].src);

      const position =
        i % (columns * rowsPerPage);

      const column =
        position % columns;

      const row =
        Math.floor(position / columns);

      const cellX =
        margin +
        column * (cellWidth + gap);

      const cellY =
        margin +
        row * (cellHeight + gap);

      const imageRatio =
        image.naturalWidth /
        image.naturalHeight;

      const cellRatio =
        cellWidth /
        cellHeight;

      let width;
      let height;

      if (imageRatio > cellRatio) {
        width = cellWidth;
        height = width / imageRatio;
      } else {
        height = cellHeight;
        width = height * imageRatio;
      }

      const x =
        cellX +
        (cellWidth - width) / 2;

      const y =
        cellY +
        (cellHeight - height) / 2;

      const format =
        image.src.startsWith("data:image/png")
          ? "PNG"
          : "JPEG";

      pdf.addImage(
        image,
        format,
        x,
        y,
        width,
        height
      );
    }

    pdf.save("images-to-pdf.pdf");
  }

  async function createImageSizePDF() {
    const firstImage =
      await loadImage(images[0].src);

    const firstOrientation =
      firstImage.naturalWidth >
      firstImage.naturalHeight
        ? "landscape"
        : "portrait";

    const selectedOrientation =
      document.getElementById("orientation").value;

    const pdf = new jsPDF({
      orientation:
        selectedOrientation === "auto"
          ? firstOrientation
          : selectedOrientation,
      unit: "px",
      format: [
        firstImage.naturalWidth,
        firstImage.naturalHeight
      ]
    });

    for (let i = 0; i < images.length; i++) {

      status.textContent =
        `Creating PDF... ${i + 1} of ${images.length}`;

      const image =
        await loadImage(images[i].src);

      if (i > 0) {
        pdf.addPage(
          [
            image.naturalWidth,
            image.naturalHeight
          ],
          image.naturalWidth > image.naturalHeight
            ? "landscape"
            : "portrait"
        );
      }

      pdf.addImage(
        image,
        image.src.startsWith("data:image/png")
          ? "PNG"
          : "JPEG",
        0,
        0,
        image.naturalWidth,
        image.naturalHeight
      );
    }

    pdf.save("images-to-pdf.pdf");
  }

  function loadImage(src) {
    return new Promise((resolve, reject) => {
      const image = new Image();

      image.onload = () => resolve(image);
      image.onerror = reject;

      image.src = src;
    });
  }

  function addImageToPDF(
    pdf,
    image,
    margin
  ) {
    const pageWidth =
      pdf.internal.pageSize.getWidth();

    const pageHeight =
      pdf.internal.pageSize.getHeight();

    const availableWidth =
      pageWidth - margin * 2;

    const availableHeight =
      pageHeight - margin * 2;

    const imageRatio =
      image.naturalWidth /
      image.naturalHeight;

    const pageRatio =
      availableWidth /
      availableHeight;

    let width;
    let height;

    if (imageRatio > pageRatio) {
      width = availableWidth;
      height = width / imageRatio;
    } else {
      height = availableHeight;
      width = height * imageRatio;
    }

    const x =
      (pageWidth - width) / 2;

    const y =
      (pageHeight - height) / 2;

    const format =
      image.src.startsWith("data:image/png")
        ? "PNG"
        : "JPEG";

    pdf.addImage(
      image,
      format,
      x,
      y,
      width,
      height
    );
  }
</script>

<style>
  .workspace {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 26px;
  }

  .upload {
    display: block;
    border: 2px dashed var(--color-border);
    border-radius: 17px;
    padding: 42px 20px;
    text-align: center;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .upload:hover,
  .upload.dragging {
    border-color: var(--color-text);
    background: var(--color-surface);
  }

  .upload-icon {
    width: 54px;
    height: 54px;
    margin: 0 auto 15px;
    border-radius: 15px;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
  }

  .upload h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }

  .upload p {
    margin: 8px 0 18px;
    color: var(--color-muted);
    font-size: 13px;
  }

  .upload-button {
    display: inline-block;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 11px 19px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
  }

  #fileInput {
    display: none;
  }

  .settings {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 24px;
  }

  .setting {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 13px;
  }

  .setting label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-muted);
    margin-bottom: 7px;
  }

  select {
    width: 100%;
    border: 0;
    background: transparent;
    outline: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
  }

  .images-section {
    margin-top: 28px;
    display: none;
  }

  .images-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 15px;
  }

  .images-header h3 {
    margin: 0;
    font-size: 16px;
  }

  .images-header span {
    color: var(--color-muted);
    font-size: 13px;
  }

  :global(.image-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  :global(.image-card) {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 13px;
    background: var(--color-bg);
    overflow: hidden;
    transition: 0.2s ease;
  }

  :global(.image-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  :global(.preview) {
    width: 100%;
    height: 155px;
    object-fit: contain;
    display: block;
    background: var(--color-surface);
  }

  :global(.image-info) {
    padding: 10px;
  }

  :global(.image-name) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 12px;
    font-weight: 600;
  }

  :global(.image-number) {
    color: var(--color-muted);
    font-size: 11px;
    margin-top: 3px;
  }

  :global(.remove-image) {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    font-size: 16px;
    line-height: 28px;
  }

  :global(.remove-image:hover) {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .actions {
    margin-top: 25px;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  button {
    font-family: inherit;
  }

  .secondary-button,
  .primary-button {
    border-radius: 10px;
    padding: 12px 19px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .secondary-button {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .secondary-button:hover {
    background: var(--color-surface);
  }

  .primary-button {
    border: 0;
    background: var(--color-text);
    color: var(--color-bg);
    min-width: 145px;
  }

  .primary-button:hover {
    opacity: 0.88;
  }

  .primary-button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .status {
    display: none;
    margin-top: 18px;
    padding: 13px 15px;
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .settings {
      grid-template-columns: repeat(2, 1fr);
    }

    :global(.image-grid) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .workspace {
      padding: 16px;
    }

    .settings {
      grid-template-columns: 1fr;
    }

    :global(.image-grid) {
      grid-template-columns: repeat(2, 1fr);
    }

    :global(.preview) {
      height: 130px;
    }

    .actions {
      flex-direction: column-reverse;
    }

    .secondary-button,
    .primary-button {
      width: 100%;
    }
  }
</style>